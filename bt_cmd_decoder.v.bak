module bt_cmd_decoder (
    input  wire        clk,
    input  wire        rst_n,
    input  wire [7:0]  bt_byte,
    input  wire        bt_byte_valid,

    output reg         code_go,
    output reg [3:0]   ded_count
);

    localparam IDLE  = 0,
               S1    = 1,
               T1    = 2,
               A1    = 3,
               R1    = 4,
               T2    = 5,
               HYP1  = 6,
               N1    = 7,
               HYP2  = 8,
               HASH  = 9;

    reg [3:0] state;
    reg [7:0] num_store;
    reg        hold_active;
    reg [31:0] hold_counter;

    wire is_digit = (bt_byte >= "0" && bt_byte <= "9");

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state <= IDLE;
            ded_count <= 1'b0;
            code_go <= 1'b0;
            num_store <= 8'b0;
        end
        else if (bt_byte_valid) begin
            case (state) 
                IDLE: state <= (bt_byte == "S") ? S1:IDLE;
                S1: state <= (bt_byte == "T") ? T1:IDLE;
                T1: state <= (bt_byte == "A") ? A1:IDLE;
                A1: state <= (bt_byte == "R") ? R1:IDLE;
                R1: state <= (bt_byte == "T") ? T2:IDLE;
                T2: state <= (bt_byte == "-") ? HYP1:IDLE;
                HYP1: begin
                    if(is_digit) begin
                        num_store <= bt_byte - "0"; // digit 0-9 is enuf
                        state <= N1;
                    end else begin
                        state <= IDLE;
                    end
                end
                N1: state <= (bt_byte == "-") ? HYP2:IDLE;
                HYP2: state <= (bt_byte == "#") ? HASH:IDLE;
                HASH: begin
                    ded_count    <= num_store;
                    hold_active  <= 1'b1;   // Start 5-sec hold
                    hold_counter <= 0;
                    state        <= IDLE;
                end

                default: ; // Ignore unknown bytes
            endcase
        end
    end

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            hold_counter <= 0;
            hold_active  <= 0;
            code_go      <= 0;
        end 
        else begin
            if (hold_active) begin
                if (hold_counter >= 32'd250_000_000) begin
                    hold_counter <= 0;
                    hold_active  <= 0;
                    code_go      <= 0;   // Done → go LOW
                end else begin
                    hold_counter <= hold_counter + 1;
                    code_go      <= 1;   // Stay HIGH
                end
            end
        end
    end

endmodule